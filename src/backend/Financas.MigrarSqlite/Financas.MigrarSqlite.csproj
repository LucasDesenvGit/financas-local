<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Financas.MigrarSqlite</RootNamespace>
    <AssemblyName>Financas.MigrarSqlite</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Único consumidor do provider SQL Server: a API em si é somente SQLite agora.
         Esta ferramenta de migração, pontual, é quem precisa falar com a base de origem. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.*" />
    <!-- Microsoft.Data.SqlClient (dependência transitiva) traz uma versão do System.Security.Cryptography.Pkcs
         com vulnerabilidade conhecida (NU1902/NU1903); fixa explicitamente na linha 10.0, já corrigida. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reaproveita o FinancasDbContext e as classes de Entidades/ sem duplicar o modelo. -->
    <ProjectReference Include="..\Financas.Api\Financas.Api.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Financas.Api</RootNamespace>
    <AssemblyName>Financas.Api</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Não gerar web.config automaticamente: usamos o nosso (com cabeçalhos de segurança do IIS) -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versões flutuantes no patch: sempre a correção de segurança mais recente da linha 10.0 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- A API cria e atualiza o banco ao iniciar com os mesmos scripts (Data/EsquemaBanco.cs, ADR 0003). -->
  <ItemGroup>
    <EmbeddedResource Include="../../../banco/01-estrutura.sql" LogicalName="banco.01-estrutura.sql" />
    <EmbeddedResource Include="../../../banco/02-dados-iniciais.sql" LogicalName="banco.02-dados-iniciais.sql" />
    <EmbeddedResource Include="../../../scripts/geral/2-criar-banco.sh" LogicalName="banco.2-criar-banco.sh" />
  </ItemGroup>

</Project>

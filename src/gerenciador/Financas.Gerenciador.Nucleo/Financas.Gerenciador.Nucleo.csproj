<Project Sdk="Microsoft.NET.Sdk">

  <!--
    O que o gerenciador faz igual no Windows e no Linux (ADR 0032): achar a instalação pelo serviço do sistema, dizer
    a situação do site e copiar o banco. Cada janela (WinForms no Windows, Avalonia no Linux) fica no próprio projeto.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Financas.Gerenciador</RootNamespace>
    <AssemblyName>Financas.Gerenciador.Nucleo</AssemblyName>
    <Product>Finanças Local</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versões flutuantes no patch, como na API. O ServiceController só é usado no Windows (ServicoWindows). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.*" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.*" />
  </ItemGroup>

</Project>

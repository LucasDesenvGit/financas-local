{
  "name": "financas-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "test": "jest",
    "test:regressao": "jest testes/jest/regressao",
    "test:usabilidade": "jest testes/jest/usabilidade",
    "test:tipos": "tsc -p tsconfig.spec.json --noEmit",
    "test:navegador": "ng build --configuration production && playwright test",
    "test:afetados": "node testes/rodar-afetados.mjs",
    "test:arquitetura": "jest --roots \"<rootDir>/testes/arquitetura\""
  },
  "dependencies": {
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@lucide/angular": "1.69.0",
    "chart.js": "^4.6.1",
    "qrcode-generator": "2.0.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@playwright/test": "^1.64.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}

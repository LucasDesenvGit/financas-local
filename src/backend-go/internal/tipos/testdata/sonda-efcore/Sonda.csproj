    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- A mesma versão da API (Financas.Api.csproj). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
  </ItemGroup>
</Project>

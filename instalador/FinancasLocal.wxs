<?xml version="1.0" encoding="utf-8"?>
<!--
  Instalador do Finanças Local para Windows (#119, ADR 0029). Gerado pelo instalador/gerar-msi.ps1 com o WiX 5:
    wix build FinancasLocal.wxs -arch x64 -culture pt-BR -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
              -d Versao=2.1.0 -bindpath app=<pasta publicada> -o FinancasLocal-2.1.0.msi
  A pasta publicada tem a API já compilada (self-contained, sem .NET instalado no computador), o back-end em Go
  (financas-go.exe), o gerenciador em Go (Financas.Gerenciador.exe, #277), o front-end no wwwroot, o appsettings.Production.json com a pasta de dados e o instalador\configurar.ps1.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- UpgradeCode fixo para sempre: é ele que faz uma versão nova substituir a anterior. -->
  <Package Name="Finanças Local" Manufacturer="Finanças Local" Version="$(Versao)"
           UpgradeCode="{6F1C2B9E-7A43-4D2E-9B8F-3C5A1E0D4F27}" Scope="perMachine" Language="1046" Codepage="1252">

    <SummaryInformation Description="Finanças Local $(Versao): gerenciamento financeiro pessoal no seu computador" />
    <!--
      A mesma versão X.Y.Z também substitui: a de desenvolvimento (X.Y.Z.N, do develop) e a do Release (X.Y.Z) trocam
      uma pela outra, em vez de ficarem as duas instaladas. O Windows Installer compara só X.Y.Z.
    -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="Uma versão mais nova do Finanças Local já está instalada. Para voltar a uma anterior, desinstale-a antes (seus dados ficam)." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!--
      Versão mínima do Windows (#277): o certificado do Go é um .pfx com AES e SHA-256, que o Windows lê a partir do
      Server 2019 (compilação 17763, a do Windows 10 versão 1809); o próprio Go pede o Windows 10. O VersionNT não serve:
      o Windows 10 e o 11 respondem 603, como o 8.1. A compilação vem do registro, e a comparação com um número é
      numérica. "Installed" deixa desinstalar e reparar em qualquer caso.
    -->
    <Property Id="COMPILACAOWINDOWS">
      <RegistrySearch Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber"
                      Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR COMPILACAOWINDOWS &gt;= 17763"
            Message="O Finanças Local precisa do Windows 10 versão 1809 ou mais novo (ou do Windows Server 2019 ou mais novo). Atualize o Windows e rode o instalador de novo." />

    <!--
      Firefox (#277, como nos scripts desde a #300): por padrão ele não usa os certificados do Windows e mostra um aviso
      no site. O instalador não muda o Firefox sozinho (ligar a opção faz ele confiar em todos os certificados do
      sistema, e essa escolha é de quem usa); só avisa na tela final. O 64 bits grava em uma visão do registro, o 32 bits
      na outra.
    -->
    <Property Id="FIREFOX64">
      <RegistrySearch Root="HKLM" Key="SOFTWARE\Mozilla\Mozilla Firefox" Name="CurrentVersion" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="FIREFOX32">
      <RegistrySearch Root="HKLM" Key="SOFTWARE\Mozilla\Mozilla Firefox" Name="CurrentVersion" Type="raw" Bitness="always32" />
    </Property>
    <!--
      WebView2 (#277, ADR 0052): a janela do gerenciador em Go é desenhada por ele. Vem no Windows 11 e na grande maioria
      dos Windows 10, mas pode faltar. O site funciona sem ele, então o instalador não para: avisa na tela final e manda
      para a página da Microsoft. As chaves e o valor "pv" são os da documentação da Microsoft ("Detect if a WebView2
      Runtime is already installed"): instalado para a máquina ou só para quem usa, com versão diferente de 0.0.0.0.
    -->
    <Property Id="WEBVIEW2MAQUINA">
      <RegistrySearch Root="HKLM" Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
                      Name="pv" Type="raw" Bitness="always32" />
    </Property>
    <Property Id="WEBVIEW2USUARIO">
      <RegistrySearch Root="HKCU" Key="Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
                      Name="pv" Type="raw" />
    </Property>
    <SetProperty Id="SEMWEBVIEW2" Value="1" Sequence="ui" After="AppSearch"
                 Condition="(NOT WEBVIEW2MAQUINA OR WEBVIEW2MAQUINA = &quot;0.0.0.0&quot;) AND (NOT WEBVIEW2USUARIO OR WEBVIEW2USUARIO = &quot;0.0.0.0&quot;)" />

    <!-- A tela final junta os dois avisos, quando cabem. -->
    <SetProperty Action="TextoFinalFirefox" Id="WIXUI_EXITDIALOGOPTIONALTEXT" Sequence="ui" After="SetSEMWEBVIEW2"
                 Condition="(FIREFOX64 OR FIREFOX32) AND NOT SEMWEBVIEW2"
                 Value="Usa o Firefox? Por padrão ele não usa os certificados do Windows e mostra um aviso no site. Para aceitar, abra about:config e deixe security.enterprise_roots.enabled como true (ou use o Edge ou o Chrome)." />
    <SetProperty Action="TextoFinalWebView2" Id="WIXUI_EXITDIALOGOPTIONALTEXT" Sequence="ui" After="TextoFinalFirefox"
                 Condition="SEMWEBVIEW2 AND NOT (FIREFOX64 OR FIREFOX32)"
                 Value="Falta o WebView2 da Microsoft, que desenha a janela do gerenciador. O site já funciona em https://127.0.0.1:5443; para o gerenciador, baixe o WebView2 em developer.microsoft.com/microsoft-edge/webview2/consumer." />
    <SetProperty Action="TextoFinalOsDois" Id="WIXUI_EXITDIALOGOPTIONALTEXT" Sequence="ui" After="TextoFinalWebView2"
                 Condition="SEMWEBVIEW2 AND (FIREFOX64 OR FIREFOX32)"
                 Value="Falta o WebView2 da Microsoft, que desenha a janela do gerenciador: baixe-o em developer.microsoft.com/microsoft-edge/webview2/consumer. Usa o Firefox? Em about:config, deixe security.enterprise_roots.enabled como true, ou ele mostra um aviso no site." />

    <Icon Id="icone.ico" SourceFile="!(bindpath.app)\instalador\icone.ico" />
    <Property Id="ARPPRODUCTICON" Value="icone.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/LucasDesenvGit/financas-local" />
    <Property Id="ARPHELPLINK" Value="https://github.com/LucasDesenvGit/financas-local#readme" />
    <!-- Desinstalar mantém os dados; "msiexec /x FinancasLocal.msi APAGARDADOS=1" apaga também. -->
    <Property Id="APAGARDADOS" Secure="yes" />
    <!-- Atalho do gerenciador na área de trabalho (de todos os usuários); "ATALHOAREADETRABALHO=0" instala sem ele. -->
    <Property Id="ATALHOAREADETRABALHO" Value="1" Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="FinancasLocal" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="PastaMenu" Name="Finanças Local" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Principal" Title="Finanças Local" Level="1">
      <ComponentGroupRef Id="Arquivos" />
      <ComponentRef Id="Servico" />
      <ComponentRef Id="Gerenciador" />
      <ComponentRef Id="Atalhos" />
      <ComponentRef Id="AtalhoAreaDeTrabalho" />
    </Feature>

    <!-- Interface: boas-vindas, pasta e progresso (sem tela de licença); no fim, abrir o gerenciador. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <!-- Imagens com a identidade do site (degradê da marca e o cofrinho); geradas por imagens\gerar-imagens.ps1. -->
    <WixVariable Id="WixUIDialogBmp" Value="$(sys.SOURCEFILEDIR)imagens\dialogo.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="$(sys.SOURCEFILEDIR)imagens\faixa.bmp" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="99" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="99" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="AbrirGerenciador"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Abrir o Gerenciador do Finanças Local" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="AbrirGerenciador" FileRef="GerenciadorExe" ExeCommand="" Execute="immediate"
                  Impersonate="yes" Return="asyncNoWait" />

    <!--
      instalador\configurar.ps1, como SYSTEM: pasta de dados protegida, migração da instalação pelos scripts (antes de
      registrar o serviço, que tem o mesmo nome) e certificado HTTPS. Na desinstalação de verdade (não na troca de
      versão), tira o certificado das Autoridades Raiz e, com APAGARDADOS=1, apaga os dados.
    -->
    <SetProperty Id="ConfigurarFinancasLocal" Sequence="execute" Before="ConfigurarFinancasLocal"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]instalador\configurar.ps1&quot; -Acao instalar" />
    <CustomAction Id="ConfigurarFinancasLocal" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="check" />
    <SetProperty Id="LimparFinancasLocal" Sequence="execute" Before="LimparFinancasLocal"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]instalador\configurar.ps1&quot; -Acao desinstalar -ApagarDados &quot;[APAGARDADOS]&quot;" />
    <CustomAction Id="LimparFinancasLocal" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="ConfigurarFinancasLocal" After="InstallFiles" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="LimparFinancasLocal" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>

  <!--
    Quem é o serviço (#277, parte 4): a API .NET, que sobe o Go como processo filho (ADR 0049), ou, com -d SoGo=1
    (gerar-msi.ps1 -SoGo), o financas-go.exe sozinho, que aplica o esquema e roda as rotinas de partida como o .NET
    faz hoje. O "só Go" fica pronto para a inversão (#85), que decide quando os pacotes publicados passam a usá-lo.
  -->
  <?ifndef SoGo?>
    <?define SoGo = 0 ?>
  <?endif?>
  <?if $(SoGo) = 1 ?>
    <?define ServicoExe = financas-go.exe ?>
  <?else?>
    <?define ServicoExe = Financas.Api.exe ?>
  <?endif?>

  <Fragment>
    <!-- Tudo da pasta publicada, menos os dois executáveis, que têm componente próprio (serviço e atalho). -->
    <ComponentGroup Id="Arquivos" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.app)\**">
        <Exclude Files="!(bindpath.app)\$(ServicoExe)" />
        <Exclude Files="!(bindpath.app)\Financas.Gerenciador.exe" />
      </Files>
    </ComponentGroup>

    <!-- Serviço do Windows: mesma conta (LocalSystem) e mesmo nome da instalação pelos scripts (ADR 0029). -->
    <Component Id="Servico" Directory="INSTALLFOLDER">
      <File Id="ApiExe" Source="!(bindpath.app)\$(ServicoExe)" KeyPath="yes" />
      <?if $(SoGo) = 1 ?>
      <ServiceInstall Id="InstalarServico" Name="FinancasLocal" DisplayName="Finanças Local"
                      Description="Site do Finanças Local em https://127.0.0.1:5443 (só neste computador)."
                      Arguments="-aplicar-esquema -rotinas-de-partida"
                      Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Vital="yes">
        <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart"
                            ThirdFailureActionType="none" RestartServiceDelayInSeconds="30" ResetPeriodInDays="1" />
      </ServiceInstall>
      <?else?>
      <ServiceInstall Id="InstalarServico" Name="FinancasLocal" DisplayName="Finanças Local"
                      Description="Site do Finanças Local em https://127.0.0.1:5443 (só neste computador)."
                      Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Vital="yes">
        <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart"
                            ThirdFailureActionType="none" RestartServiceDelayInSeconds="30" ResetPeriodInDays="1" />
      </ServiceInstall>
      <?endif?>
      <ServiceControl Id="ControlarServico" Name="FinancasLocal" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
    </Component>

    <Component Id="Gerenciador" Directory="INSTALLFOLDER">
      <File Id="GerenciadorExe" Source="!(bindpath.app)\Financas.Gerenciador.exe" KeyPath="yes" />
    </Component>

    <Component Id="Atalhos" Directory="PastaMenu">
      <Shortcut Id="AtalhoGerenciador" Name="Gerenciador do Finanças Local" Description="Ver se o site está no ar, ligar, desligar e atualizar"
                Target="[#GerenciadorExe]" WorkingDirectory="INSTALLFOLDER" />
      <util:InternetShortcut Id="AtalhoSite" Name="Finanças Local" Target="https://127.0.0.1:5443/" />
      <RemoveFolder Id="RemoverPastaMenu" On="uninstall" />
      <RegistryValue Root="HKLM" Key="Software\FinancasLocal" Name="Atalhos" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="AtalhoAreaDeTrabalho" Directory="DesktopFolder" Condition="ATALHOAREADETRABALHO = 1">
      <Shortcut Id="AtalhoGerenciadorAreaDeTrabalho" Name="Gerenciador do Finanças Local"
                Description="Ver se o site está no ar, ligar, desligar e atualizar" Target="[#GerenciadorExe]"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKLM" Key="Software\FinancasLocal" Name="AtalhoAreaDeTrabalho" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
